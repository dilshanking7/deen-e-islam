rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Community post images/videos uploaded by authenticated users.
    match /community-posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profile photos uploaded by the owner.
    match /profile-photos/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}